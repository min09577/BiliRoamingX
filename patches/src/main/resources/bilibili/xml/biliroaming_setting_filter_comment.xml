<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.preference.PreferenceCategory>
        <androidx.preference.SwitchPreferenceCompat
            android:key="show_comment_ip_location"
            android:summary="@string/biliroaming_show_comment_ip_summary"
            android:title="@string/biliroaming_show_comment_ip_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="show_comment_floor"
            android:summary="@string/biliroaming_show_comment_floor_summary"
            android:title="@string/biliroaming_show_comment_floor_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="show_comment_reply_count"
            android:summary="@string/biliroaming_show_comment_reply_count_summary"
            android:title="@string/biliroaming_show_comment_reply_count_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="block_comment_only_at"
            android:title="@string/biliroaming_block_comment_only_at_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="block_comment_goods"
            android:title="@string/biliroaming_block_comment_goods_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="comment_sort_by_time"
            android:summary="@string/biliroaming_comment_sort_time_summary"
            android:title="@string/biliroaming_comment_sort_time_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="comment_translate"
            android:summary="@string/biliroaming_comment_translate_summary"
            android:title="@string/biliroaming_comment_translate_title" />
        <androidx.preference.Preference
            android:fragment="app.revanced.bilibili.settings.fragments.FilterCommentByKeywordFragment"
            android:key="filter_comment_by_keyword"
            android:title="@string/biliroaming_filter_by_keyword_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="comment_anonymous_mode"
            android:summary="@string/biliroaming_comment_anonymous_mode_summary"
            android:title="@string/biliroaming_comment_anonymous_mode_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="comment_gif_auto_play"
            android:summary="@string/biliroaming_comment_gif_auto_play_summary"
            android:title="@string/biliroaming_comment_gif_auto_play_title" />
        <androidx.preference.SwitchPreferenceCompat
            android:key="comment_image_auto_load"
            android:summary="@string/biliroaming_comment_image_auto_load_summary"
            android:title="@string/biliroaming_comment_image_auto_load_title" />
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
